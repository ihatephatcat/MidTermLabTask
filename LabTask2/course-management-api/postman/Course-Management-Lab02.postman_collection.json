  "item": [
    {
      "name": "List courses",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/course"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"JSON response has a message\", function () { pm.expect(pm.response.json()).to.have.property(\"message\"); });"
            ]
          }
        }
      ]
    },
