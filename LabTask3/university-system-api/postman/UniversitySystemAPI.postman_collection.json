      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response matches the required result\", function () {",
              "  pm.expect(pm.response.json()).to.deep.equal({\"message\":\"All courses fetched\",\"data\":[]});",
              "});"
            ]
          }
        }
